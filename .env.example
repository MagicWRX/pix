# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Direct Postgres connection (Supabase Dashboard -> Project Settings -> Database -> Connection string)
# Use the pooled connection string (port 6543) for serverless-friendly pooling.
DATABASE_URL=<redacted>

PORT=3000

# Public base URL for classic-film clip files (Backblaze B2 public bucket).
# Example: https://f002.backblazeb2.com/file/public-domain
# Leave empty until the clips are uploaded; the player shows a "coming soon" state.
CLASSIC_CLIPS_BASE_URL=

# Auto-dice: films to cut live here; chunks land in DICE_OUTPUT_DIR.
# Defaults: ./media and ./data/diced (relative to the app dir).
DICE_MEDIA_DIR=./media
DICE_OUTPUT_DIR=./data/diced
